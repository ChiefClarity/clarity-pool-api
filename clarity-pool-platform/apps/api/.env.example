# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Poolbrain API
POOLBRAIN_API_URL=https://api.poolbrain.com
POOLBRAIN_API_KEY=your-poolbrain-api-key

# JWT Authentication
JWT_SECRET=your-jwt-secret-change-in-production

# Application
NODE_ENV=development
PORT=3000

# AI Services
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-2
S3_BUCKET_NAME=your-s3-bucket-name

# Email Configuration
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
FRONT_CHANNEL_EMAIL=notifications@yourcompany.com
CC_EMAILS=

# Admin Configuration
ADMIN_EMAILS=admin@yourcompany.com,manager@yourcompany.com
ADMIN_JWT_SECRET=your-admin-jwt-secret-change-this
ADMIN_DASHBOARD_URL=http://localhost:3001

# Report Configuration
WEATHER_API_KEY=your-openweather-api-key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5
REPORT_DELAY_MINUTES=5
POOLBRAIN_WEBHOOK_SECRET=your-webhook-secret-change-this

# Optional: Google Custom Search (for equipment search)
# GOOGLE_CSE_ID=your-google-cse-id

# Optional: Sentry Error Tracking
# SENTRY_DSN=your-sentry-dsn

# Optional: OpenTelemetry Monitoring
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=clarity-pool-api

# Optional: Direct Database URL (for migrations)
# DIRECT_URL=postgresql://user:password@direct-host:port/database